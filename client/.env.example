# Backend Socket.io/API URL. Leave unset for local dev — the client
# auto-detects it from the page's own hostname (so it works whether you open
# the app via localhost or your LAN IP for phone testing).
#
# Required once you deploy the frontend somewhere separate from the backend
# (e.g. frontend on Vercel, backend on Render) — point it at the deployed
# backend's public URL:
# VITE_SERVER_URL=https://your-backend.onrender.com

# Only needed if your backend runs on a non-default port AND you're relying
# on the auto-detect fallback above (i.e. VITE_SERVER_URL is unset).
# VITE_SERVER_PORT=4000
