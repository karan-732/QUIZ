# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the SERVICE ROLE key here, not the anon key — this server needs to
# bypass RLS to write session/response logs. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=4000

# Comma-separated list of allowed frontend origins for CORS / Socket.io
# e.g. http://localhost:5173,https://your-frontend.vercel.app
# Use "*" for local LAN testing (players join from phones at your machine's
# LAN IP, e.g. http://192.168.1.5:5173, which won't match a literal localhost
# origin). Lock this down to real domains before deploying publicly.
CLIENT_ORIGIN=*
